{
  "name": "shadow-mcp",
  "version": "0.1.0",
  "description": "Read-only MCP server for the meetings Shadow saves as Markdown in its Vault folder.",
  "mcpName": "io.github.Taper-Labs/shadow-mcp",
  "license": "MIT",
  "author": {
    "name": "Taper Labs",
    "url": "https://www.shadow.do"
  },
  "homepage": "https://www.shadow.do/agents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Taper-Labs/shadow-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Taper-Labs/shadow-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "meetings",
    "meeting-notes",
    "transcripts",
    "markdown",
    "obsidian",
    "shadow"
  ],
  "type": "module",
  "bin": {
    "shadow-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "test": "npm run build && vitest run",
    "lint": "eslint .",
    "bench": "node scripts/bench.mjs",
    "pack:mcpb": "npm run build && node scripts/pack-mcpb.mjs",
    "prepublishOnly": "npm run build && npm test && npm run lint"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "4.1.12"
  }
}
